{"id":"bdb/Breakpoint.bpformat","module":"bdb","qualname":"Breakpoint.bpformat","name":"bpformat","kind":"method","parent":"bdb/Breakpoint","signatures":["Breakpoint.bpformat()"],"doc":"Return a string with information about the breakpoint.\n\nThe information includes the breakpoint number, temporary\nstatus, file:line position, break condition, number of times to\nignore, and number of times hit.","docsUrl":"https://docs.python.org/3.15/library/bdb.html#bdb.Breakpoint.bpformat","added":"3.2","changed":[],"deprecated":null,"availability":[],"source":{"path":"Lib/bdb.py","line":1054},"implDetail":false,"isAsync":false},
