{"id":"winsound/SND_PURGE","module":"winsound","qualname":"SND_PURGE","name":"SND_PURGE","kind":"data","parent":null,"signatures":[],"doc":"Stop playing all instances of the specified sound.","docsUrl":"https://docs.python.org/3.15/library/winsound.html#winsound.SND_PURGE","added":null,"changed":[],"deprecated":null,"availability":["Windows"],"source":null,"implDetail":false,"isAsync":false},
