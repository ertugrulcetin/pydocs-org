{"id":"winsound/SND_SYNC","module":"winsound","qualname":"SND_SYNC","name":"SND_SYNC","kind":"data","parent":null,"signatures":[],"doc":"The sound is played synchronously. This is the default behavior.","docsUrl":"https://docs.python.org/3.15/library/winsound.html#winsound.SND_SYNC","added":"3.14","changed":[],"deprecated":null,"availability":["Windows"],"source":null,"implDetail":false,"isAsync":false},
