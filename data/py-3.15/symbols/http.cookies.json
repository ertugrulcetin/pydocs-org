{"id":"http.cookies/Morsel.update","module":"http.cookies","qualname":"Morsel.update","name":"update","kind":"method","parent":"http.cookies/Morsel","signatures":["Morsel.update(values)"],"doc":"D.update([E, ]**F) -> None.  Update D from mapping/iterable E and F.\nIf E is present and has a .keys() method, then does:  for k in E.keys(): D[k] = E[k]\nIf E is present and lacks a .keys() method, then does:  for k, v in E: D[k] = v\nIn either case, this is followed by: for k in F:  D[k] = F[k]","docsUrl":"https://docs.python.org/3.15/library/http.cookies.html#http.cookies.Morsel.update","added":null,"changed":[{"version":"3.5","text":"an error is raised for invalid keys."}],"deprecated":null,"availability":[],"source":{"path":"Lib/http/cookies.py","line":335},"implDetail":false,"isAsync":false},
