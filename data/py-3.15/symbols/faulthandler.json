{"id":"faulthandler/dump_traceback_later","module":"faulthandler","qualname":"dump_traceback_later","name":"dump_traceback_later","kind":"function","parent":null,"signatures":["dump_traceback_later(timeout, repeat=False, file=sys.stderr, exit=False, *, max_threads=100)"],"doc":"Dump the traceback of all threads in timeout seconds.\n\nIf repeat is true, the tracebacks of all threads are dumped every\ntimeout seconds.  If exit is true, call _exit(1) which is not safe.\nmax_threads caps the number of threads dumped.","docsUrl":"https://docs.python.org/3.15/library/faulthandler.html#faulthandler.dump_traceback_later","added":null,"changed":[{"version":"3.5","text":"Added support for passing file descriptor to this function."},{"version":"3.7","text":"This function is now always available."},{"version":"3.15","text":"Added the max_threads keyword argument."}],"deprecated":null,"availability":[],"source":null,"implDetail":false,"isAsync":false},
