{"id":"resource/error","module":"resource","qualname":"error","name":"error","kind":"exception","parent":null,"signatures":[],"doc":"Base class for I/O related errors.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.error","added":null,"changed":[{"version":"3.3","text":"Following PEP 3151, this class was made an alias of OSError."}],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/getpagesize","module":"resource","qualname":"getpagesize","name":"getpagesize","kind":"function","parent":null,"signatures":["getpagesize()"],"doc":"Returns the number of bytes in a system page. (This need not be the same as the hardware page size.)","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.getpagesize","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/getrlimit","module":"resource","qualname":"getrlimit","name":"getrlimit","kind":"function","parent":null,"signatures":["getrlimit(resource)"],"doc":"Returns a tuple (soft, hard) with the current soft and hard limits of resource. Raises ValueError if an invalid resource is specified, or error if the underlying system call fails unexpectedly.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.getrlimit","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/getrusage","module":"resource","qualname":"getrusage","name":"getrusage","kind":"function","parent":null,"signatures":["getrusage(who)"],"doc":"This function returns an object that describes the resources consumed by either the current process or its children, as specified by the who parameter. The who parameter should be specified using one of the RUSAGE_* constants described below.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.getrusage","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/prlimit","module":"resource","qualname":"prlimit","name":"prlimit","kind":"function","parent":null,"signatures":["prlimit(pid, resource[, limits])"],"doc":"Combines setrlimit() and getrlimit() in one function and supports to get and set the resources limits of an arbitrary process. If pid is 0, then the call applies to the current process. resource and limits have the same meaning as in setrlimit(), except that limits is optional.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.prlimit","added":"3.4","changed":[],"deprecated":null,"availability":["Linux >= 2.6.36 with glibc >= 2.13"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIM_INFINITY","module":"resource","qualname":"RLIM_INFINITY","name":"RLIM_INFINITY","kind":"data","parent":null,"signatures":[],"doc":"Constant used to represent the limit for an unlimited resource.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIM_INFINITY","added":null,"changed":[{"version":"3.15","text":"It is now always positive. Previously, it could be negative, such as -1 or -3."}],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIM_SAVED_CUR","module":"resource","qualname":"RLIM_SAVED_CUR","name":"RLIM_SAVED_CUR","kind":"data","parent":null,"signatures":[],"doc":"Constants used to represent the soft and hard limit values if they cannot be represented in the rlim_t value in C. Can be equal to RLIM_INFINITY.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIM_SAVED_CUR","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIM_SAVED_MAX","module":"resource","qualname":"RLIM_SAVED_MAX","name":"RLIM_SAVED_MAX","kind":"data","parent":null,"signatures":[],"doc":"Constants used to represent the soft and hard limit values if they cannot be represented in the rlim_t value in C. Can be equal to RLIM_INFINITY.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIM_SAVED_MAX","added":"3.15","changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_AS","module":"resource","qualname":"RLIMIT_AS","name":"RLIMIT_AS","kind":"data","parent":null,"signatures":[],"doc":"The maximum area (in bytes) of address space which may be taken by the process.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_AS","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_CORE","module":"resource","qualname":"RLIMIT_CORE","name":"RLIMIT_CORE","kind":"data","parent":null,"signatures":[],"doc":"The maximum size (in bytes) of a core file that the current process can create. This may result in the creation of a partial core file if a larger core would be required to contain the entire process image.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_CORE","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_CPU","module":"resource","qualname":"RLIMIT_CPU","name":"RLIMIT_CPU","kind":"data","parent":null,"signatures":[],"doc":"The maximum amount of processor time (in seconds) that a process can use. If this limit is exceeded, a SIGXCPU signal is sent to the process. (See the signal module documentation for information about how to catch this signal and do something useful, e.g. flush open files to disk.)","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_CPU","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_DATA","module":"resource","qualname":"RLIMIT_DATA","name":"RLIMIT_DATA","kind":"data","parent":null,"signatures":[],"doc":"The maximum size (in bytes) of the process’s heap.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_DATA","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_FSIZE","module":"resource","qualname":"RLIMIT_FSIZE","name":"RLIMIT_FSIZE","kind":"data","parent":null,"signatures":[],"doc":"The maximum size of a file which the process may create.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_FSIZE","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_KQUEUES","module":"resource","qualname":"RLIMIT_KQUEUES","name":"RLIMIT_KQUEUES","kind":"data","parent":null,"signatures":[],"doc":"The maximum number of kqueues this user id is allowed to create.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_KQUEUES","added":"3.10","changed":[],"deprecated":null,"availability":["FreeBSD >= 11"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_MEMLOCK","module":"resource","qualname":"RLIMIT_MEMLOCK","name":"RLIMIT_MEMLOCK","kind":"data","parent":null,"signatures":[],"doc":"The maximum address space which may be locked in memory.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_MEMLOCK","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_MSGQUEUE","module":"resource","qualname":"RLIMIT_MSGQUEUE","name":"RLIMIT_MSGQUEUE","kind":"data","parent":null,"signatures":[],"doc":"The number of bytes that can be allocated for POSIX message queues.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_MSGQUEUE","added":"3.4","changed":[],"deprecated":null,"availability":["Linux >= 2.6.8"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_NICE","module":"resource","qualname":"RLIMIT_NICE","name":"RLIMIT_NICE","kind":"data","parent":null,"signatures":[],"doc":"The ceiling for the process’s nice level (calculated as 20 - rlim_cur).","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_NICE","added":"3.4","changed":[],"deprecated":null,"availability":["Linux >= 2.6.12"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_NOFILE","module":"resource","qualname":"RLIMIT_NOFILE","name":"RLIMIT_NOFILE","kind":"data","parent":null,"signatures":[],"doc":"The maximum number of open file descriptors for the current process.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_NOFILE","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_NPROC","module":"resource","qualname":"RLIMIT_NPROC","name":"RLIMIT_NPROC","kind":"data","parent":null,"signatures":[],"doc":"The maximum number of processes the current process may create.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_NPROC","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_NPTS","module":"resource","qualname":"RLIMIT_NPTS","name":"RLIMIT_NPTS","kind":"data","parent":null,"signatures":[],"doc":"The maximum number of pseudo-terminals created by this user id.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_NPTS","added":"3.4","changed":[],"deprecated":null,"availability":["FreeBSD >= 8"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_NTHR","module":"resource","qualname":"RLIMIT_NTHR","name":"RLIMIT_NTHR","kind":"data","parent":null,"signatures":[],"doc":"The maximum number of threads for this user id, not counting the main and kernel threads.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_NTHR","added":"3.15","changed":[],"deprecated":null,"availability":["NetBSD >= 7.0"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_OFILE","module":"resource","qualname":"RLIMIT_OFILE","name":"RLIMIT_OFILE","kind":"data","parent":null,"signatures":[],"doc":"The BSD name for RLIMIT_NOFILE.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_OFILE","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_PIPEBUF","module":"resource","qualname":"RLIMIT_PIPEBUF","name":"RLIMIT_PIPEBUF","kind":"data","parent":null,"signatures":[],"doc":"The maximum total size of in-kernel buffers for bi-directional pipes/fifos that this user id is allowed to consume.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_PIPEBUF","added":"3.15","changed":[],"deprecated":null,"availability":["FreeBSD >= 14.2"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_RSS","module":"resource","qualname":"RLIMIT_RSS","name":"RLIMIT_RSS","kind":"data","parent":null,"signatures":[],"doc":"The maximum resident set size that should be made available to the process.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_RSS","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_RTPRIO","module":"resource","qualname":"RLIMIT_RTPRIO","name":"RLIMIT_RTPRIO","kind":"data","parent":null,"signatures":[],"doc":"The ceiling of the real-time priority.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_RTPRIO","added":"3.4","changed":[],"deprecated":null,"availability":["Linux >= 2.6.12"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_RTTIME","module":"resource","qualname":"RLIMIT_RTTIME","name":"RLIMIT_RTTIME","kind":"data","parent":null,"signatures":[],"doc":"The time limit (in microseconds) on CPU time that a process can spend under real-time scheduling without making a blocking syscall.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_RTTIME","added":"3.4","changed":[],"deprecated":null,"availability":["Linux >= 2.6.25"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_SBSIZE","module":"resource","qualname":"RLIMIT_SBSIZE","name":"RLIMIT_SBSIZE","kind":"data","parent":null,"signatures":[],"doc":"The maximum size (in bytes) of socket buffer usage for this user. This limits the amount of network memory, and hence the amount of mbufs, that this user may hold at any time.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_SBSIZE","added":"3.4","changed":[],"deprecated":null,"availability":["FreeBSD","NetBSD"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_SIGPENDING","module":"resource","qualname":"RLIMIT_SIGPENDING","name":"RLIMIT_SIGPENDING","kind":"data","parent":null,"signatures":[],"doc":"The number of signals which the process may queue.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_SIGPENDING","added":"3.4","changed":[],"deprecated":null,"availability":["Linux >= 2.6.8"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_STACK","module":"resource","qualname":"RLIMIT_STACK","name":"RLIMIT_STACK","kind":"data","parent":null,"signatures":[],"doc":"The maximum size (in bytes) of the call stack for the current process. This only affects the stack of the main thread in a multi-threaded process.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_STACK","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_SWAP","module":"resource","qualname":"RLIMIT_SWAP","name":"RLIMIT_SWAP","kind":"data","parent":null,"signatures":[],"doc":"The maximum size (in bytes) of the swap space that may be reserved or used by all of this user id’s processes. This limit is enforced only if bit 1 of the vm.overcommit sysctl is set. Please see tuning(7) for a complete description of this sysctl.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_SWAP","added":"3.4","changed":[],"deprecated":null,"availability":["FreeBSD >= 8"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_THREADS","module":"resource","qualname":"RLIMIT_THREADS","name":"RLIMIT_THREADS","kind":"data","parent":null,"signatures":[],"doc":"The maximum number of threads each process can create.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_THREADS","added":"3.15","changed":[],"deprecated":null,"availability":["AIX"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_UMTXP","module":"resource","qualname":"RLIMIT_UMTXP","name":"RLIMIT_UMTXP","kind":"data","parent":null,"signatures":[],"doc":"The limit of the number of process-shared Posix thread library objects allocated by user id.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_UMTXP","added":"3.15","changed":[],"deprecated":null,"availability":["FreeBSD >= 11"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RLIMIT_VMEM","module":"resource","qualname":"RLIMIT_VMEM","name":"RLIMIT_VMEM","kind":"data","parent":null,"signatures":[],"doc":"The largest area of mapped memory which the process may occupy. Usually an alias of RLIMIT_AS.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RLIMIT_VMEM","added":null,"changed":[],"deprecated":null,"availability":["Solaris","FreeBSD","NetBSD"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RUSAGE_BOTH","module":"resource","qualname":"RUSAGE_BOTH","name":"RUSAGE_BOTH","kind":"data","parent":null,"signatures":[],"doc":"Pass to getrusage() to request resources consumed by both the current process and child processes. May not be available on all systems.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RUSAGE_BOTH","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RUSAGE_CHILDREN","module":"resource","qualname":"RUSAGE_CHILDREN","name":"RUSAGE_CHILDREN","kind":"data","parent":null,"signatures":[],"doc":"Pass to getrusage() to request resources consumed by child processes of the calling process which have been terminated and waited for.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RUSAGE_CHILDREN","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RUSAGE_SELF","module":"resource","qualname":"RUSAGE_SELF","name":"RUSAGE_SELF","kind":"data","parent":null,"signatures":[],"doc":"Pass to getrusage() to request resources consumed by the calling process, which is the sum of resources used by all threads in the process.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RUSAGE_SELF","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/RUSAGE_THREAD","module":"resource","qualname":"RUSAGE_THREAD","name":"RUSAGE_THREAD","kind":"data","parent":null,"signatures":[],"doc":"Pass to getrusage() to request resources consumed by the current thread. May not be available on all systems.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.RUSAGE_THREAD","added":"3.2","changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false},
{"id":"resource/setrlimit","module":"resource","qualname":"setrlimit","name":"setrlimit","kind":"function","parent":null,"signatures":["setrlimit(resource, limits)"],"doc":"Sets new limits of consumption of resource. The limits argument must be a tuple (soft, hard) of two integers describing the new limits. A value of RLIM_INFINITY can be used to request a limit that is unlimited.","docsUrl":"https://docs.python.org/3.15/library/resource.html#resource.setrlimit","added":null,"changed":[],"deprecated":null,"availability":["Unix","not WASI"],"source":null,"implDetail":false,"isAsync":false}
]
