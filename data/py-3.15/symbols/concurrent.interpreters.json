{"id":"concurrent.interpreters/QueueEmpty","module":"concurrent.interpreters","qualname":"QueueEmpty","name":"QueueEmpty","kind":"exception","parent":null,"signatures":[],"doc":"Raised from get_nowait() when the queue is empty.\n\nIt is also raised from get() if it times out.","docsUrl":"https://docs.python.org/3.15/library/concurrent.interpreters.html#concurrent.interpreters.QueueEmpty","added":null,"changed":[],"deprecated":null,"availability":["not WASI"],"source":{"path":"Lib/concurrent/interpreters/_queues.py","line":26},"implDetail":false,"isAsync":false},
