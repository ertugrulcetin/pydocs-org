{"id":"concurrent.interpreters/Queue.get","module":"concurrent.interpreters","qualname":"Queue.get","name":"get","kind":"method","parent":"concurrent.interpreters/Queue","signatures":["Queue.get(block=True, timeout=None)"],"doc":"Return the next object from the queue.\n\nIf \"block\" is true, this blocks while the queue is empty.\n\nIf the next item's original interpreter has been destroyed\nthen the \"next object\" is determined by the value of the\n\"unbounditems\" argument to put().","docsUrl":"https://docs.python.org/3.15/library/concurrent.interpreters.html#concurrent.interpreters.Queue.get","added":null,"changed":[],"deprecated":null,"availability":["not WASI"],"source":{"path":"Lib/concurrent/interpreters/_queues.py","line":241},"implDetail":false,"isAsync":false},
{"id":"concurrent.interpreters/Queue.get_nowait","module":"concurrent.interpreters","qualname":"Queue.get_nowait","name":"get_nowait","kind":"method","parent":"concurrent.interpreters/Queue","signatures":["Queue.get_nowait()"],"doc":"Return the next object from the channel.\n\nIf the queue is empty then raise QueueEmpty.  Otherwise this\nis the same as get().","docsUrl":"https://docs.python.org/3.15/library/concurrent.interpreters.html#concurrent.interpreters.Queue.get_nowait","added":null,"changed":[],"deprecated":null,"availability":["not WASI"],"source":{"path":"Lib/concurrent/interpreters/_queues.py","line":273},"implDetail":false,"isAsync":false},
