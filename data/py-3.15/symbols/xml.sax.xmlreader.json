{"id":"xml.sax.xmlreader/InputSource.setByteStream","module":"xml.sax.xmlreader","qualname":"InputSource.setByteStream","name":"setByteStream","kind":"method","parent":"xml.sax.xmlreader/InputSource","signatures":["InputSource.setByteStream(bytefile)"],"doc":"Set the byte stream (a Python file-like object which does\nnot perform byte-to-character conversion) for this input\nsource.\n\nThe SAX parser will ignore this if there is also a character\nstream specified, but it will use a byte stream in preference\nto opening a URI connection itself.\n\nIf the application knows the character encoding of the byte\nstream, it should set it with the setEncoding method.","docsUrl":"https://docs.python.org/3.15/library/xml.sax.reader.html#xml.sax.xmlreader.InputSource.setByteStream","added":null,"changed":[],"deprecated":null,"availability":[],"source":{"path":"Lib/xml/sax/xmlreader.py","line":240},"implDetail":false,"isAsync":false},
{"id":"xml.sax.xmlreader/InputSource.setCharacterStream","module":"xml.sax.xmlreader","qualname":"InputSource.setCharacterStream","name":"setCharacterStream","kind":"method","parent":"xml.sax.xmlreader/InputSource","signatures":["InputSource.setCharacterStream(charfile)"],"doc":"Set the character stream for this input source. (The stream\nmust be a Python 2.0 Unicode-wrapped file-like that performs\nconversion to Unicode strings.)\n\nIf there is a character stream specified, the SAX parser will\nignore any byte stream and will not attempt to open a URI\nconnection to the system identifier.","docsUrl":"https://docs.python.org/3.15/library/xml.sax.reader.html#xml.sax.xmlreader.InputSource.setCharacterStream","added":null,"changed":[],"deprecated":null,"availability":[],"source":{"path":"Lib/xml/sax/xmlreader.py","line":260},"implDetail":false,"isAsync":false},
{"id":"xml.sax.xmlreader/InputSource.setEncoding","module":"xml.sax.xmlreader","qualname":"InputSource.setEncoding","name":"setEncoding","kind":"method","parent":"xml.sax.xmlreader/InputSource","signatures":["InputSource.setEncoding(encoding)"],"doc":"Sets the character encoding of this InputSource.\n\nThe encoding must be a string acceptable for an XML encoding\ndeclaration (see section 4.3.3 of the XML recommendation).\n\nThe encoding attribute of the InputSource is ignored if the\nInputSource also contains a character stream.","docsUrl":"https://docs.python.org/3.15/library/xml.sax.reader.html#xml.sax.xmlreader.InputSource.setEncoding","added":null,"changed":[],"deprecated":null,"availability":[],"source":{"path":"Lib/xml/sax/xmlreader.py","line":226},"implDetail":false,"isAsync":false},
