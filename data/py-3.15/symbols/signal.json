{"id":"signal/set_wakeup_fd","module":"signal","qualname":"set_wakeup_fd","name":"set_wakeup_fd","kind":"function","parent":null,"signatures":["set_wakeup_fd(fd, *, warn_on_full_buffer=True)"],"doc":"Sets the fd to be written to (with the signal number) when a signal comes in.\n\nA library can use this to wakeup select or poll.\nThe previous fd or -1 is returned.\n\nThe fd must be non-blocking.","docsUrl":"https://docs.python.org/3.15/library/signal.html#signal.set_wakeup_fd","added":null,"changed":[{"version":"3.5","text":"On Windows, the function now also supports socket handles."},{"version":"3.7","text":"Added warn_on_full_buffer parameter."}],"deprecated":null,"availability":[],"source":null,"implDetail":false,"isAsync":false},
{"id":"signal/setitimer","module":"signal","qualname":"setitimer","name":"setitimer","kind":"function","parent":null,"signatures":["setitimer(which, seconds, interval=0)"],"doc":"Sets given itimer (one of ITIMER_REAL, ITIMER_VIRTUAL or ITIMER_PROF).\n\nThe timer will fire after value seconds and after that every interval\nseconds.  The itimer can be cleared by setting seconds to zero.\n\nReturns old values as a tuple: (delay, interval).","docsUrl":"https://docs.python.org/3.15/library/signal.html#signal.setitimer","added":null,"changed":[{"version":"3.15","text":"Accepts any real numbers as seconds and interval, not only integers or floats."}],"deprecated":null,"availability":["Unix"],"source":null,"implDetail":false,"isAsync":false},
