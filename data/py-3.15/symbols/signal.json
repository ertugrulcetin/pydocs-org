{"id":"signal/ITIMER_PROF","module":"signal","qualname":"ITIMER_PROF","name":"ITIMER_PROF","kind":"data","parent":null,"signatures":[],"doc":"Decrements interval timer both when the process executes and when the system is executing on behalf of the process. Coupled with ITIMER_VIRTUAL, this timer is usually used to profile the time spent by the application in user and kernel space. SIGPROF is delivered upon expiration.","docsUrl":"https://docs.python.org/3.15/library/signal.html#signal.ITIMER_PROF","added":null,"changed":[],"deprecated":null,"availability":[],"source":null,"implDetail":false,"isAsync":false},
