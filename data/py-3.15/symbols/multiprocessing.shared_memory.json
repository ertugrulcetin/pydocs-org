{"id":"multiprocessing.shared_memory/SharedMemory.close","module":"multiprocessing.shared_memory","qualname":"SharedMemory.close","name":"close","kind":"method","parent":"multiprocessing.shared_memory/SharedMemory","signatures":["SharedMemory.close()"],"doc":"Closes access to the shared memory from this instance but does\nnot destroy the shared memory block.","docsUrl":"https://docs.python.org/3.15/library/multiprocessing.shared_memory.html#multiprocessing.shared_memory.SharedMemory.close","added":null,"changed":[],"deprecated":null,"availability":[],"source":{"path":"Lib/multiprocessing/shared_memory.py","line":225},"implDetail":false,"isAsync":false},
