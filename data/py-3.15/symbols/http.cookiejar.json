{"id":"http.cookiejar/DefaultCookiePolicy.strict_domain","module":"http.cookiejar","qualname":"DefaultCookiePolicy.strict_domain","name":"strict_domain","kind":"attribute","parent":"http.cookiejar/DefaultCookiePolicy","signatures":[],"doc":"Don’t allow sites to set two-component domains with country-code top-level domains like .co.uk, .gov.uk, .co.nz.etc. This is far from perfect and isn’t guaranteed to work!","docsUrl":"https://docs.python.org/3.15/library/http.cookiejar.html#http.cookiejar.DefaultCookiePolicy.strict_domain","added":null,"changed":[],"deprecated":null,"availability":[],"source":null,"implDetail":false,"isAsync":false},
