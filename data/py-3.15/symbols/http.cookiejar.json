{"id":"http.cookiejar/DefaultCookiePolicy.strict_ns_unverifiable","module":"http.cookiejar","qualname":"DefaultCookiePolicy.strict_ns_unverifiable","name":"strict_ns_unverifiable","kind":"attribute","parent":"http.cookiejar/DefaultCookiePolicy","signatures":[],"doc":"Apply RFC 2965 rules on unverifiable transactions even to Netscape cookies.","docsUrl":"https://docs.python.org/3.15/library/http.cookiejar.html#http.cookiejar.DefaultCookiePolicy.strict_ns_unverifiable","added":null,"changed":[],"deprecated":null,"availability":[],"source":null,"implDetail":false,"isAsync":false},
{"id":"http.cookiejar/DefaultCookiePolicy.strict_rfc2965_unverifiable","module":"http.cookiejar","qualname":"DefaultCookiePolicy.strict_rfc2965_unverifiable","name":"strict_rfc2965_unverifiable","kind":"attribute","parent":"http.cookiejar/DefaultCookiePolicy","signatures":[],"doc":"Follow RFC 2965 rules on unverifiable transactions (usually, an unverifiable transaction is one resulting from a redirect or a request for an image hosted on another site). If this is false, cookies are never blocked on the basis of verifiability","docsUrl":"https://docs.python.org/3.15/library/http.cookiejar.html#http.cookiejar.DefaultCookiePolicy.strict_rfc2965_unverifiable","added":null,"changed":[],"deprecated":null,"availability":[],"source":null,"implDetail":false,"isAsync":false},
{"id":"http.cookiejar/FileCookieJar","module":"http.cookiejar","qualname":"FileCookieJar","name":"FileCookieJar","kind":"class","parent":null,"signatures":["FileCookieJar(filename=None, delayload=None, policy=None)"],"doc":"CookieJar that can be loaded from and saved to a file.","docsUrl":"https://docs.python.org/3.15/library/http.cookiejar.html#http.cookiejar.FileCookieJar","added":null,"changed":[{"version":"3.8","text":"The filename parameter supports a path-like object."}],"deprecated":null,"availability":[],"source":{"path":"Lib/http/cookiejar.py","line":1792},"implDetail":false,"isAsync":false},
{"id":"http.cookiejar/FileCookieJar.delayload","module":"http.cookiejar","qualname":"FileCookieJar.delayload","name":"delayload","kind":"attribute","parent":"http.cookiejar/FileCookieJar","signatures":[],"doc":"If true, load cookies lazily from disk. This attribute should not be assigned to. This is only a hint, since this only affects performance, not behaviour (unless the cookies on disk are changing). A CookieJar object may ignore it. None of the FileCookieJar classes included in the standard library lazily loads cookies.","docsUrl":"https://docs.python.org/3.15/library/http.cookiejar.html#http.cookiejar.FileCookieJar.delayload","added":null,"changed":[],"deprecated":null,"availability":[],"source":null,"implDetail":false,"isAsync":false},
{"id":"http.cookiejar/FileCookieJar.filename","module":"http.cookiejar","qualname":"FileCookieJar.filename","name":"filename","kind":"attribute","parent":"http.cookiejar/FileCookieJar","signatures":[],"doc":"Filename of default file in which to keep cookies. This attribute may be assigned to.","docsUrl":"https://docs.python.org/3.15/library/http.cookiejar.html#http.cookiejar.FileCookieJar.filename","added":null,"changed":[],"deprecated":null,"availability":[],"source":null,"implDetail":false,"isAsync":false},
{"id":"http.cookiejar/FileCookieJar.load","module":"http.cookiejar","qualname":"FileCookieJar.load","name":"load","kind":"method","parent":"http.cookiejar/FileCookieJar","signatures":["FileCookieJar.load(filename=None, ignore_discard=False, ignore_expires=False)"],"doc":"Load cookies from a file.","docsUrl":"https://docs.python.org/3.15/library/http.cookiejar.html#http.cookiejar.FileCookieJar.load","added":null,"changed":[{"version":"3.3","text":"IOError used to be raised, it is now an alias of OSError."}],"deprecated":null,"availability":[],"source":{"path":"Lib/http/cookiejar.py","line":1811},"implDetail":false,"isAsync":false},
{"id":"http.cookiejar/FileCookieJar.revert","module":"http.cookiejar","qualname":"FileCookieJar.revert","name":"revert","kind":"method","parent":"http.cookiejar/FileCookieJar","signatures":["FileCookieJar.revert(filename=None, ignore_discard=False, ignore_expires=False)"],"doc":"Clear all cookies and reload cookies from a saved file.\n\nRaises LoadError (or OSError) if reversion is not successful; the\nobject's state will not be altered if this happens.","docsUrl":"https://docs.python.org/3.15/library/http.cookiejar.html#http.cookiejar.FileCookieJar.revert","added":null,"changed":[],"deprecated":null,"availability":[],"source":{"path":"Lib/http/cookiejar.py","line":1820},"implDetail":false,"isAsync":false},
{"id":"http.cookiejar/FileCookieJar.save","module":"http.cookiejar","qualname":"FileCookieJar.save","name":"save","kind":"method","parent":"http.cookiejar/FileCookieJar","signatures":["FileCookieJar.save(filename=None, ignore_discard=False, ignore_expires=False)"],"doc":"Save cookies to a file.","docsUrl":"https://docs.python.org/3.15/library/http.cookiejar.html#http.cookiejar.FileCookieJar.save","added":null,"changed":[],"deprecated":null,"availability":[],"source":{"path":"Lib/http/cookiejar.py","line":1807},"implDetail":false,"isAsync":false},
{"id":"http.cookiejar/LoadError","module":"http.cookiejar","qualname":"LoadError","name":"LoadError","kind":"exception","parent":null,"signatures":[],"doc":"Instances of FileCookieJar raise this exception on failure to load cookies from a file. LoadError is a subclass of OSError.","docsUrl":"https://docs.python.org/3.15/library/http.cookiejar.html#http.cookiejar.LoadError","added":null,"changed":[{"version":"3.3","text":"LoadError used to be a subtype of IOError, which is now an alias of OSError."}],"deprecated":null,"availability":[],"source":{"path":"Lib/http/cookiejar.py","line":1790},"implDetail":false,"isAsync":false},
{"id":"http.cookiejar/LWPCookieJar","module":"http.cookiejar","qualname":"LWPCookieJar","name":"LWPCookieJar","kind":"class","parent":null,"signatures":["LWPCookieJar(filename=None, delayload=None, policy=None)"],"doc":"The LWPCookieJar saves a sequence of \"Set-Cookie3\" lines.\n\"Set-Cookie3\" is the format used by the libwww-perl library, not known\nto be compatible with any browser, but which is easy to read and\ndoesn't lose information about RFC 2965 cookies.\n\nAdditional methods\n\nas_lwp_str(ignore_discard=True, ignore_expired=True)","docsUrl":"https://docs.python.org/3.15/library/http.cookiejar.html#http.cookiejar.LWPCookieJar","added":null,"changed":[{"version":"3.8","text":"The filename parameter supports a path-like object."}],"deprecated":null,"availability":[],"source":{"path":"Lib/http/cookiejar.py","line":1875},"implDetail":false,"isAsync":false},
{"id":"http.cookiejar/MozillaCookieJar","module":"http.cookiejar","qualname":"MozillaCookieJar","name":"MozillaCookieJar","kind":"class","parent":null,"signatures":["MozillaCookieJar(filename=None, delayload=None, policy=None)"],"doc":"WARNING: you may want to backup your browser's cookies file if you use\nthis class to save cookies.  I *think* it works, but there have been\nbugs in the past!\n\nThis class differs from CookieJar only in the format it uses to save and\nload cookies to and from a file.  This class uses the Mozilla/Netscape\n'cookies.txt' format.  curl and lynx use this file format, too.\n\nDon't expect cookies saved while the browser is running to be noticed by\nthe browser (in fact, Mozilla on unix will overwrite your saved cookies if\nyou change them on disk while it's running; on Windows, you probably can't\nsave at all while the browser is running).\n\nNote that the Mozilla/Netscape format will downgrade RFC2965 cookies to\nNetscape cookies on saving.\n\nIn particular, the cookie version and port number information is lost,\ntogether with information about whether or not Path, Port and Discard were\nspecified by the Set-Cookie2 (or Set-Cookie) header, and whether or not the\ndomain as set in the HTTP header started with a dot (yes, I'm aware some\ndomains in Netscape files start with a dot and some don't -- trust me, you\nreally don't want to know any more about this).\n\nNote that though Mozilla and Netscape use the same format, they use\nslightly different headers.  The class saves cookies using the Netscape\nheader by default (Mozilla can cope with that).","docsUrl":"https://docs.python.org/3.15/library/http.cookiejar.html#http.cookiejar.MozillaCookieJar","added":null,"changed":[],"deprecated":null,"availability":[],"source":{"path":"Lib/http/cookiejar.py","line":1996},"implDetail":false,"isAsync":false}
]
