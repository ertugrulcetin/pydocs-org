{"id":"http.cookiejar/DefaultCookiePolicy.strict_ns_set_initial_dollar","module":"http.cookiejar","qualname":"DefaultCookiePolicy.strict_ns_set_initial_dollar","name":"strict_ns_set_initial_dollar","kind":"attribute","parent":"http.cookiejar/DefaultCookiePolicy","signatures":[],"doc":"Ignore cookies in Set-Cookie: headers that have names starting with '$'.","docsUrl":"https://docs.python.org/3.15/library/http.cookiejar.html#http.cookiejar.DefaultCookiePolicy.strict_ns_set_initial_dollar","added":null,"changed":[],"deprecated":null,"availability":[],"source":null,"implDetail":false,"isAsync":false},
