{"id":"email.headerregistry/ParameterizedMIMEHeader","module":"email.headerregistry","qualname":"ParameterizedMIMEHeader","name":"ParameterizedMIMEHeader","kind":"class","parent":null,"signatures":[],"doc":"MIME headers all start with the prefix ‘Content-’. Each specific header has a certain value, described under the class for that header. Some can also take a list of supplemental parameters, which have a common format. This class serves as a base for all the MIME headers that take parameters.","docsUrl":"https://docs.python.org/3.15/library/email.headerregistry.html#email.headerregistry.ParameterizedMIMEHeader","added":null,"changed":[],"deprecated":null,"availability":[],"source":{"path":"Lib/email/headerregistry.py","line":437},"implDetail":false,"isAsync":false},
