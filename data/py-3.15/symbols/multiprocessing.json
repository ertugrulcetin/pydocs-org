{"id":"multiprocessing/set_executable","module":"multiprocessing","qualname":"set_executable","name":"set_executable","kind":"function","parent":null,"signatures":["set_executable(executable)"],"doc":"Sets the path to a python.exe or pythonw.exe binary used to run\nchild processes instead of sys.executable when using the 'spawn'\nstart method.  Useful for people embedding Python.","docsUrl":"https://docs.python.org/3.15/library/multiprocessing.html#multiprocessing.set_executable","added":null,"changed":[{"version":"3.4","text":"Now supported on POSIX when the 'spawn' start method is used."},{"version":"3.11","text":"Accepts a path-like object."}],"deprecated":null,"availability":["not Android","not iOS","not WASI"],"source":{"path":"Lib/multiprocessing/context.py","line":179},"implDetail":false,"isAsync":false},
{"id":"multiprocessing/set_forkserver_preload","module":"multiprocessing","qualname":"set_forkserver_preload","name":"set_forkserver_preload","kind":"function","parent":null,"signatures":["set_forkserver_preload(module_names, *, on_error='ignore')"],"doc":"Set list of module names to try to load in forkserver process.\n\nThe on_error parameter controls how import failures are handled:\n\"ignore\" (default) silently ignores failures, \"warn\" emits warnings,\nand \"fail\" raises exceptions breaking the forkserver context.","docsUrl":"https://docs.python.org/3.15/library/multiprocessing.html#multiprocessing.set_forkserver_preload","added":"3.4","changed":[{"version":"3.15","text":"Added the on_error parameter."}],"deprecated":null,"availability":["not Android","not iOS","not WASI"],"source":{"path":"Lib/multiprocessing/context.py","line":187},"implDetail":false,"isAsync":false},
{"id":"multiprocessing/set_start_method","module":"multiprocessing","qualname":"set_start_method","name":"set_start_method","kind":"function","parent":null,"signatures":["set_start_method(method, force=False)"],"doc":"Set the method which should be used to start child processes. The method argument can be 'fork', 'spawn' or 'forkserver'. Raises RuntimeError if the start method has already been set and force is not True. If method is None and force is True then the start method is set to None. If method is None and force is False then the context is set to the default context.","docsUrl":"https://docs.python.org/3.15/library/multiprocessing.html#multiprocessing.set_start_method","added":"3.4","changed":[],"deprecated":null,"availability":["not Android","not iOS","not WASI"],"source":{"path":"Lib/multiprocessing/context.py","line":264},"implDetail":false,"isAsync":false},
