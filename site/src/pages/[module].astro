---
// Module page = ClojureDocs' namespace page (pages/nss.clj). URL: /{module}.
import Main from '../layouts/Main.astro';
import LibraryNav from '../components/LibraryNav.astro';
import ChapterMobileNav from '../components/ChapterMobileNav.astro';
import SymbolList from '../components/SymbolList.astro';
import type { PyModule } from '../lib/data';
import { modules, summary, topLevelByModule } from '../lib/data';

export function getStaticPaths() {
  return modules.map((module) => ({ params: { module: module.name }, props: { module } }));
}

interface Props {
  module: PyModule;
}
const { module: m } = Astro.props;
const syms = topLevelByModule.get(m.name) ?? [];
const doc = m.doc ?? m.synopsis ?? '';
---

<Main title={m.name} description={m.synopsis ?? summary(doc)} bodyClass="ns-page">
  <ChapterMobileNav slot="mobile-nav" module={m.name} />
  <div class="container">
    <div class="row">
      <div class="col-md-10 col-md-offset-1">
        <div>
          <div class="row">
            <div class="col-sm-2 sidenav">
              <div class="desktop-side-nav"><LibraryNav module={m.name} /></div>
            </div>
            <div class="col-sm-10">
              <h1>{m.name}</h1>
              {
                (m.deprecated || m.availability.length > 0) && (
                  <p class="dialect-badges">
                    {m.deprecated && <span class="label label-danger" title={m.deprecated.text}>Deprecated{m.deprecated.version ? ` ${m.deprecated.version}` : ''}</span>}
                    {m.availability.map((a) => <span class="label label-info">{a}</span>)}
                  </p>
                )
              }
              <section class="markdown">
                {doc && <pre class="doc">{doc}</pre>}
                <p class="copyright">
                  © Python Software Foundation. <a href="https://docs.python.org/3/license.html">PSF License Version 2</a> · <a href={m.docsUrl}>Official docs ↗</a>
                </p>
              </section>
              <SymbolList heading={`Symbols in ${m.name}`} symbols={syms} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Main>
