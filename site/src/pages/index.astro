---
// Home = ClojureDocs' intro page (pages/intro.clj). Example of the Day and
// Recently Updated arrive with community content (Phase 4).
import Main from '../layouts/Main.astro';
import { homeCategories, homeModules } from '../lib/quickref';
import { summary, symbolUrl, moduleUrl } from '../lib/data';
import { githubStars } from '../lib/github';
import { exampleOfTheDay, recentActivity } from '../lib/community-data';
import { highlightPython } from '../lib/highlight';
import { avatarUrl, timeago } from '../lib/community-client';

const eotd = exampleOfTheDay();
const WHAT = { example: 'an example', seeAlso: 'a see also', note: 'a note' } as const;
const VERB = { create: 'authored', edit: 'edited', delete: 'deleted' } as const;

const stars = await githubStars();

const short = (doc: string | null) => {
  const s = summary(doc, 400);
  return s.length > 40 ? `${s.slice(0, 40).trimEnd()}…` : s;
};
---

<Main bodyClass="intro-page" home stars={stars}>
  <div class="container">
    <div class="row">
      <div class="col-md-10 col-md-offset-1">
        <div>
          <div class="row">
            <div class="col-md-12">
              <section>
                <h1>Community-powered documentation and examples for <a href="https://www.python.org">Python</a></h1>
              </section>
              <section>
                <div class="search-widget">
                  <div class="quick-lookup-wrapper">
                    <form action="/search" autocomplete="off" class="search" method="get" role="search">
                      <input autocomplete="off" autofocus class="form-control query" name="q" placeholder="Looking for?" type="text" aria-label="Search" />
                    </form>
                    <ul class="ac-results"></ul>
                  </div>
                </div>
              </section>
            </div>
          </div>
          {
            eotd && (
              <div class="row">
                <div class="col-md-12">
                  <div class="example-of-the-day var-example">
                    <div class="eotd-head">
                      <span>Example of the day</span>
                      <a href={`/${eotd.sid}#example-${eotd.ex.id}`}>{eotd.sid}</a>
                    </div>
                    <div class="example-body">
                      <pre class="syntaxify" set:html={highlightPython(eotd.ex.body)} />
                    </div>
                  </div>
                </div>
              </div>
            )
          }
          <div class="row">
            <div class="col-md-6">
              <section>
                <div class="sec-head clearfix"><h5>Recently Updated</h5></div>
                <div id="recently-updated">
                  {
                    recentActivity.length ? (
                      recentActivity.map((e) => (
                        <div class="recently-updated">
                          <a class="avatar-link" href={`/u/${e.user.login}`}>
                            <img class="avatar" src={avatarUrl(e.user.id, 48)} alt="" />
                          </a>
                          <span class="content">
                            {e.user.login} {VERB[e.action]} {WHAT[e.type]} for <a href={`/${e.symbol}`}>{e.symbol}</a> {timeago(e.at)} ago.
                            <div class="clear" />
                          </span>
                        </div>
                      ))
                    ) : (
                      <p class="null-state">No contributions yet. Be the first!</p>
                    )
                  }
                </div>
              </section>
            </div>
            <div class="col-md-6">
              <section class="contribute-teaser">
                <div class="sec-head clearfix"><h5>Contribute to PyDocs</h5></div>
                <p>Give feedback, add examples, or link related functions.</p>
                <span class="sec-head-link"><a href="/contribute">Learn how to pitch in →</a></span>
              </section>
            </div>
          </div>
          <div class="row">
            <div class="col-md-12">
              <section class="core-index-section">
                <div class="sec-head clearfix">
                  <h5>Python, by purpose</h5>
                  <span class="sec-head-link"><a href="/quickref">Full quick reference →</a></span>
                </div>
                <div class="sphere">
                  {
                    homeCategories.map((c) => {
                      const syms = c.groups.flatMap((g) => g.symbols);
                      return (
                        <div class="category">
                          <div class="category-header clearfix">
                            <h3>
                              {c.title}
                              <span class="n">{c.count}</span>
                            </h3>
                          </div>
                          <dl class="dl-horizontal">
                            {syms.slice(0, 10).map((s) => (
                              <div class="dl-row">
                                <dt><a href={symbolUrl(s)} title={s.qualname}>{s.qualname}</a></dt>
                                <dd>{short(s.doc)}</dd>
                              </div>
                            ))}
                            {syms.length > 10 && (
                              <div class="dl-row">
                                <dt />
                                <dd><a href={`/quickref#${c.slug}`}>+{syms.length - 10} more</a></dd>
                              </div>
                            )}
                          </dl>
                        </div>
                      );
                    })
                  }
                </div>
              </section>
            </div>
          </div>
          <div class="row">
            <div class="col-md-12">
              <section class="namespaces-section">
                <div class="sec-head clearfix">
                  <h5>More modules</h5>
                  <span class="sec-head-link"><a href="/library">Browse all modules →</a></span>
                </div>
                <div class="namespace-cards">
                  {
                    homeModules.map(({ module: mod, highlights }) => (
                      <div class="namespace-card">
                        <h4><a href={moduleUrl(mod.name)}>{mod.name}</a></h4>
                        <p class="doc">{mod.synopsis}</p>
                        <p class="vars">{highlights.map((s) => <a href={symbolUrl(s)}>{s.qualname}</a>)}</p>
                      </div>
                    ))
                  }
                </div>
              </section>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script>
    import '../scripts/recent-activity.ts';
  </script>
</Main>
