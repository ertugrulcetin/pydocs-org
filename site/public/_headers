# Applies to static assets only; the Worker sets its own headers.
# CSP (PLAN.md §11). Enforced after a report-only run on the live site showed one
# violation: Cloudflare Web Analytics' injected beacon (allowed below).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' https://avatars.githubusercontent.com data:; font-src 'self'; connect-src 'self' https://data.pydocs.org https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Pages link CSS with ?v=<content hash> (src/lib/assets.ts), so cache it for a year.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Versioned by content hash (?v=...), so cache for a long time.
/search-index/*
  Cache-Control: public, max-age=31536000, immutable

# Example runner (PLAN.md Phase 8): embedded as <iframe sandbox="allow-scripts">
# by our own pages, so it may be framed by them; it runs Pyodide (WebAssembly)
# in a blob: (classic) worker. Replaces the site-wide CSP and X-Frame-Options.
# no-transform: Cloudflare must not inject the Web Analytics beacon into this
# hidden frame (it would count every Run as a page view, and the CSP blocks it).
/runner
  ! Content-Security-Policy
  ! X-Frame-Options
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  Content-Security-Policy: default-src 'none'; script-src 'self' blob: 'wasm-unsafe-eval'; worker-src blob:; connect-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'

# Pyodide runtime: fetched from the sandboxed (opaque-origin) runner, so it
# needs CORS; versioned by directory, so cache it for a year.
/pyodide/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
