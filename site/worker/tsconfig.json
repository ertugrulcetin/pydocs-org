{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2024"
    ],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "./**/*.ts",
    "../shared/**/*.ts",
    "../worker-configuration.d.ts"
  ]
}
