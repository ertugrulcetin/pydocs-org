{
  "name": "pydocs-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "node scripts/assert-case-sensitive.mjs && astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck:worker": "wrangler types && tsc -p worker",
    "astro": "astro",
    "test": "node --test tests/",
    "check:layout": "node e2e/layout-check.mjs",
    "typecheck:site": "tsc --noEmit -p .",
    "test:e2e": "node e2e/search.mjs && node e2e/community.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "astro": "^7.4.5",
    "dompurify": "3.4.17",
    "marked": "18.1.3",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "wrangler": "4.156.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261102.1": true,
    "fsevents@2.3.3": true
  }
}
